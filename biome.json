{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "asNeeded" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "tailwind": {
    "stylesheet": "src/index.css"
  },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended", "tailwind": "recommended", "test": "recommended" },
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useTailwindSortedClasses": { "level": "error", "fix": "safe" },
        "useTailwindShorthandClasses": { "level": "error", "fix": "safe" }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
