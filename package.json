{
  "name": "rika-react-fundamentals",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "My courses app from the EPAM React Fundamentals course (2021), rebuilt with React 19, Redux Toolkit and a backend of my own",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite --mode server",
    "server": "bun --watch server/main.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@reduxjs/toolkit": "^2.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
